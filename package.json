{
  "name": "@aaron212/astro-pele",
  "version": "0.0.1",
  "description": "Render Mermaid diagrams with Pele in Astro and Sätteri.",
  "keywords": [
    "astro",
    "astro-integration",
    "markdown",
    "mermaid",
    "pele",
    "renderer",
    "satteri"
  ],
  "homepage": "https://demos.aaron212.com/astro-pele/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aaron-212/astro-pele.git"
  },
  "files": [
    "dist",
    "src/components/*.astro"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./components/Mermaid.astro": "./src/components/Mermaid.astro",
    "./satteri": {
      "types": "./dist/satteri.d.ts",
      "import": "./dist/satteri.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && astro check --tsconfig tsconfig.astro.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint"
  },
  "dependencies": {
    "entities": "^8.1.0",
    "pele": "^1.8.0",
    "satteri": "^0.10.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "^0.4.3",
    "astro": "^7.3.8",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.87.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@astrojs/markdown-satteri": "^0.3.7 || ^0.4.0",
    "astro": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/markdown-satteri": {
      "optional": true
    },
    "astro": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1"
}
